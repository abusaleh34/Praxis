{
  "name": "praxis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "start:preview": "node scripts/start-preview.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node --env-file-if-exists=.env.local scripts/e2e.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "content:generate": "node scripts/generate-content.mjs",
    "quality:authored": "node scripts/evaluate-authored.mjs",
    "quality:ai": "node --env-file-if-exists=.env.local scripts/evaluate-ai.mjs"
  },
  "dependencies": {
    "next": "16.3.8",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "1.58.2",
    "prettier": "3.6.2",
    "railway": "3.12.0",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}
