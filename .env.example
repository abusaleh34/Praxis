# Run npm run setup:local to generate local database and admin credentials.
DATABASE_URL=
PRAXIS_ADMIN_TOKEN=
PRAXIS_MODE=development
PRAXIS_SECURE_COOKIES=false
# Private hosted preview. Username is praxis; choose a random 24+ character password.
PRAXIS_PREVIEW_REQUIRED=false
PRAXIS_PREVIEW_PASSWORD=
# Optional waitlist channel. PRAXIS_MODE also supports waitlist and pilot.
PRAXIS_TELEGRAM_CHANNEL_URL=
# Pilot mode requires a reviewed question bank, a pilot code, and readiness flags.
PRAXIS_PILOT_CODE=
PRAXIS_DEMAND_VALIDATED=false
PRAXIS_PRIVACY_REVIEWED=false
PRAXIS_HINT_QUALITY_APPROVED=false
# Optional model integration. Authored hints are available without this.
PRAXIS_AI_API_KEY=
PRAXIS_AI_MODEL=
PRAXIS_AI_DAILY_REQUEST_LIMIT=100
PRAXIS_EVAL_CASE_LIMIT=5
# Keep empty until the offer duration, terms, and payment provider are approved.
PRAXIS_CHECKOUT_URL=
PRAXIS_OFFER_DESCRIPTION=
